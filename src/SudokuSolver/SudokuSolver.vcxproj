  <!-- docs/SDD.md 3.1: samples/ is copied beside the exe so both the
       end-to-end tests and TP-506's "copy the exe and samples/ to a clean
       machine" work without a path convention nobody wrote down. -->
  <Target Name="CopySamples" AfterTargets="Build">
    <ItemGroup>
      <SampleFiles Include="$(SolutionDir)samples\*.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(SampleFiles)" DestinationFolder="$(OutDir)samples" SkipUnchangedFiles="true" />
