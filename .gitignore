# Visual Studio 2022 / MSBuild working files.
#
# docs/SDD.md 3.1: .sln, .vcxproj and .vcxproj.filters are TRACKED —
# RTVM-900 is "an openable solution, not source files alone". This file
# excludes build output and per-user state, and nothing else that matters.

# Per-user IDE state
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output
x64/
Debug/
Release/
[Bb]in/
[Oo]bj/

# Compiler / linker intermediates that can land outside those folders
*.obj
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.log
*.lastbuildstate
*.pch
*.ipch
*.iobj
*.ipdb

# Test output
TestResults/
